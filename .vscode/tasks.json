{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-docs",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "linux": {
                "type": "shell",
                "command": "bash",
                "args": [
                    "-c",
                    "docker run --rm --user \"$(id -u):$(id -g)\" --volume \"${workspaceFolder}:/documents\" --volume \"${config:docs.outputBaseDir}/python-examples:/output\" --workdir /documents asciidoctor/docker-asciidoctor@sha256:23c022800c00bd7b73fe4e3deca49c77500f0fb34035b131cfed3f835e8d9de9 make -C docs adoc CP_OPTS=-n DIST_DIR=/output"
                ]
            },
            "windows": {
                "type": "shell",
                "command": "wslc",
                "args": [
                    "run",
                    "--rm",
                    "--user",
                    "1000:1000",
                    "--volume",
                    "${workspaceFolder}:/documents",
                    "--volume",
                    "${config:docs.outputBaseDir}\\python-examples:/output",
                    "--workdir",
                    "/documents",
                    "--env",
                    "HOME=/tmp",
                    "--env",
                    "XDG_CACHE_HOME=/tmp/.cache",
                    "asciidoctor/docker-asciidoctor@sha256:23c022800c00bd7b73fe4e3deca49c77500f0fb34035b131cfed3f835e8d9de9",
                    "make",
                    "-C",
                    "docs",
                    "adoc",
                    "CP_OPTS=-n",
                    "DIST_DIR=/output"
                ]
            },
            "problemMatcher": []
        }
    ]
}